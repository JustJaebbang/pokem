# MySQL: fill these locally; never commit .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pokem
DB_PASSWORD=
DB_NAME=pokem


# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Chat DB connections per server process
CHAT_DB_POOL_SIZE=8

# Account recovery email (single API worker; TLS required)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# FCM: apply sql/push_notifications.sql and configure Firebase before enabling.
PUSH_ENABLED=false
# Absolute path to server-only service account JSON (never commit the file).
GOOGLE_APPLICATION_CREDENTIALS=
